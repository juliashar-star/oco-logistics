# Скопируйте в корень проекта как .env и заполните значения.
# cp infra/.env.example .env   (Linux/macOS)
# copy infra\.env.example .env (Windows)

# PostgreSQL (локально — значения из infra/docker-compose.yml)
DATABASE_URL="postgresql://oco:oco_dev_password@localhost:15432/oco_logistics?schema=public"

# APIShip — только на сервере, не в браузере
# Тестовая песочница (публичные учётные данные для разработки):
APISHIP_BASE_URL="http://api.dev.apiship.ru/v1/"
APISHIP_LOGIN="test"
APISHIP_PASSWORD="test"
# Бой (M4): https://api.apiship.ru/v1/ + логин/пароль из личного кабинета APIShip

# Яндекс Доставка (Доставка по России). Тест: https://b2b.taxi.tst.yandex.net
# Бой: https://b2b-authproxy.taxi.yandex.net
YANDEX_DELIVERY_BASE_URL=

# Яндекс Express (claims/* /b2b/cargo/integration/v2). Тест: https://b2b.taxi.tst.yandex.net
# Бой: https://b2b.taxi.yandex.net
# Differs from YANDEX_DELIVERY_BASE_URL in production only — that is why it is a separate variable.
YANDEX_EXPRESS_BASE_URL=

# СДЭК API. Must point at the SANDBOX https://api.edu.cdek.ru
# Must never be set to production without an explicit decision.
CDEK_BASE_URL=

# Deployment contour for the carrier base URLs above — "sandbox" or "production"; the server refuses to start if it is unset/unrecognised or mismatched with a host above.
OCO_CARRIER_CONTOUR=sandbox

# Шифрование пароля APIShip в базе (apishipPasswordEnc) — длинная случайная строка, мин. 32 символа
APISHIP_ENCRYPTION_KEY="change-me-to-another-long-random-string-32chars-min"

# Шифрование ПДн получателя в Shipment (recipientName, recipientPhone, destAddress) — отдельный ключ, мин. 32 символа
RECIPIENT_PII_ENCRYPTION_KEY="change-me-to-another-long-random-string-32chars-min"

# Шифрование credentials перевозчиков в CarrierCredential — отдельный ключ, мин. 32 символа
CARRIER_CREDENTIALS_ENCRYPTION_KEY=

# Сессии / авторизация (случайная строка минимум 16 символов)
AUTH_SECRET="change-me-to-a-long-random-string"

# DaData — подсказки адреса (только на сервере, не в браузере)
DADATA_API_KEY=        # dadata.ru → личный кабинет → API-ключи

# Окружение
NODE_ENV="development"

# Публичный URL приложения (для ссылок в письмах)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Origin приложения для CSRF-проверки мутирующих API-запросов (только сервер)
APP_ORIGIN="http://localhost:3000"
UNISENDER_GO_FROM_EMAIL=noreply@useoco.ru
FOUNDER_NOTIFICATION_EMAIL=founder@useoco.ru

# CSP: dev-only relaxations (unsafe-eval, style unsafe-inline) для Fast Refresh.
# Применяется только вместе с APP_ORIGIN на localhost — не задавайте в production.
CSP_DEV_RELAXATIONS=1

# Публичная страница «Сравнение перевозчиков» (KN3-3). Только сервер, не в браузере.
# true — маршрут /carrier-comparison доступен; иначе 404.
ENABLE_CARRIER_COMPARISON_PAGE=false
