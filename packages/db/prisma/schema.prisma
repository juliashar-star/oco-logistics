generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  OPERATOR
}

enum ProductCategory {
  FASHION
  BEAUTY
  WELLNESS
  PET
  OTHER
}

enum PickupType {
  COURIER
  PVZ
}

/// How the parcel reaches the carrier: a courier collects it from the seller,
/// or the seller brings it to a carrier point. DISTINCT from PickupType,
/// which despite its name describes the LAST mile (where the buyer collects).
enum HandoverMode {
  COURIER
  DROP_OFF
}

enum SelectionMode {
  FAST
  CHEAP
  OPTIMAL
  MANUAL
}

/// The company's default priority on the offers screen — which card arrives
/// already selected. EXACTLY TWO VALUES, and deliberately NOT SelectionMode:
/// that enum carries OPTIMAL, and optimal is the one word we refuse to compute,
/// because its only implementation scores every carrier with a placeholder 50
/// (rank-quotes.ts NEUTRAL_CARRIER_SCORE). A type that can hold a state the
/// product rejects is an invitation to store it.
enum OfferPriority {
  CHEAPEST
  FASTEST
}

enum ShipmentStatus {
  DRAFT
  SUBMITTING
  CREATED
  IN_TRANSIT
  AT_PVZ
  DELIVERED
  RETURNED
  CANCELED
  PROBLEM
}

// Neutral codes from CarrierConfirmResult.warnings — never provider message text.
enum CarrierConfirmWarning {
  REQUIREMENT_UNMET
  PARCEL_MAY_NOT_FIT
  ADDRESS_NOT_FOUND
  ADDRESS_COORDINATE_MISMATCH
  UNKNOWN
}

/// Which family of offer fields the recorded deadline day was derived from.
/// INTERVAL = deliveryIntervalTo, and it WINS whenever it is usable. CALENDAR_DAY
/// = deliveryDayTo, with deliveryDayFrom as the fallback when it is blank.
/// deliveryIntervalFrom is not read at all — the LATE edge of a window is what a
/// carrier commits to, and the early edge would flatter the widest interval.
/// The day is computed by `offerDeadlineWithBasis` in
/// packages/core/src/carrier-adapter/offer-deadline.ts — the same code the offers
/// screen resolves its own day with, so a stored decision can never name a day
/// the seller was not shown.
/// Measured 31.08.2026, and it is a fact about today's adapters rather than a
/// guarantee: the two families do not co-occur on one offer — CDEK fills days
/// and leaves intervals "", Yandex fills intervals and no day field.
enum DeadlineBasis {
  CALENDAR_DAY
  INTERVAL
}

model Company {
  id            String     @id @default(cuid())
  name          String
  inn           String?
  contactEmail  String
  senderCity    String?
  senderAddress String?
  senderPhone   String?
  /// NULL means «the seller has not chosen», which is NOT the same as a value
  /// we picked for them. No default and no backfill on purpose: with NULL the
  /// offers screen behaves exactly as it does today — nothing preselected and
  /// nothing said. A DEFAULT here would give every existing company a
  /// preference it never expressed.
  defaultOfferPriority OfferPriority?
  apishipLogin          String?
  apishipPasswordEnc    String?    // пароль APIShip, зашифрован на сервере
  apishipConnectedAt    DateTime?
  users                     User[]
  shipments                 Shipment[]
  quotes                    TariffQuote[]
  carrierConnectionRequests CarrierConnectionRequest[]
  carrierCredentials        CarrierCredential[]
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
}

model User {
  id                      String               @id @default(cuid())
  companyId               String
  company                 Company              @relation(fields: [companyId], references: [id])
  email                   String               @unique
  passwordHash            String
  name                    String?
  warehouseAddress        String?
  role                    UserRole             @default(OWNER)
  emailVerified           Boolean              @default(false)
  verificationToken       String?              @unique
  verificationTokenExpiry DateTime?
  passwordResetTokens     PasswordResetToken[]
  createdAt               DateTime             @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Carrier {
  id          String         @id @default(cuid())
  apishipCode String         @unique
  name        String
  isActive    Boolean        @default(true)
  shipments   Shipment[]
  quotes      TariffQuote[]
  scores      CarrierScore[]
}

model Shipment {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  createdByUserId String?

  category        ProductCategory @default(OTHER)
  weightG         Int
  lengthCm        Int
  widthCm         Int
  heightCm        Int
  declaredValue   Int?

  destCity        String
  destAddress     String?
  destApartment   String?
  deliveryComment String?
  pvzCode         String?
  // Which carrier network the chosen pickup point belongs to. The destination
  // list now spans several carriers; a point is exactly one network, so the
  // order can only go through that carrier — but the row used to store only
  // pvzCode, and a CDEK office code is not a Yandex station id. Nullable sibling
  // of providerKey (plain string, not a Prisma enum). Null when there is no
  // point (courier) or when the draft predates this field.
  pvzProviderKey  String?
  pickupType      PickupType      @default(PVZ)
  // Default DROP_OFF: cheaper branch — an inattentive seller saves money rather than overpaying.
  handoverMode    HandoverMode    @default(DROP_OFF)
  // Seller asked for a thermal bag. Services that cannot carry it stay listed
  // and are marked on the card (registry supportsThermalBag).
  needsThermalBag Boolean       @default(false)
  recipientName   String
  recipientPhone  String

  carrierId       String?
  carrier         Carrier?        @relation(fields: [carrierId], references: [id])
  selectionMode   SelectionMode?
  serviceCode     String?

  plannedCost          Int?
  plannedDeliveryDays  Int?
  plannedDeliveryDate  DateTime?
  // Carrier's interval END; null when the carrier gave no upper bound, or on paths that never had one.
  plannedDeliveryDateTo DateTime?

  actualCost           Int?
  pickedUpAt           DateTime?
  arrivedAtPvzAt       DateTime?
  deliveredAt          DateTime?
  isOnTime             Boolean?
  isReturned           Boolean    @default(false)
  isCanceled           Boolean    @default(false)
  returnReason         String?

  apishipOrderId       String?
  trackNumber          String?
  trackingUrl          String?    // страница отслеживания от перевозчика
  labelUrl             String?    // URL этикетки PDF от APIShip

  idempotencyKey         String?
  providerKey            String?
  providerOrderId        String?
  // ORDER_ADAPTERS key that produced this order, e.g. "yataxi:next_day";
  // null means it predates this field and falls back to the default entry.
  orderAdapterKey        String?
  selectedOfferId        String?
  // The service name as the CARRIER itself calls it (CDEK: tariff_name, e.g.
  // «Посылка склад-склад»). Null when the carrier gives no name at all — both
  // Yandex families never send one — so nullable here is required, not
  // convenient. The registry title (order-adapter-seller-titles) covers the
  // adapter, not the tariff, and cannot stand in for this.
  selectedOfferServiceName String?
  selectedOfferExpiresAt DateTime?
  submittingAt           DateTime?
  // Holds the CarrierOffer[] from the last getOffers call. Yandex returns the
  // delivery price ONLY in the offer — after offers/confirm it is unrecoverable
  // from any endpoint (request/info carries the interval but
  // billing_info.delivery_cost is the collect-from-recipient amount, zero for
  // already_paid). Kept after submit on purpose: "what was quoted" is Carrier
  // Score's input. PD-free — a Yandex offer carries only
  // offer_id/expires_at/intervals/pricing/station_id.
  quotedOffers           Json?
  // Neutral confirm warnings (codes only). Banner is one-shot; these outlive it.
  confirmWarnings        CarrierConfirmWarning[] @default([])

  status          ShipmentStatus  @default(DRAFT)
  legalBasisConfirmed Boolean     @default(false)
  isAnonymized    Boolean         @default(false)

  quotes          TariffQuote[]
  trackingEvents  TrackingEvent[]
  decision        ShipmentDecision?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([trackNumber])
}

model TariffQuote {
  id               String   @id @default(cuid())
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id])
  shipmentId       String?
  shipment         Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrierId        String
  carrier          Carrier   @relation(fields: [carrierId], references: [id])
  serviceCode      String
  cost             Int
  deliveryDaysMin  Int?
  deliveryDaysMax  Int?
  pickupType       PickupType
  rawResponse      Json?
  createdAt        DateTime  @default(now())

  @@index([shipmentId])
  @@index([carrierId])
  @@index([companyId])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  statusCode  String
  statusText  String
  location    String?
  eventAt     DateTime
  rawResponse Json?
  createdAt   DateTime @default(now())

  @@unique([shipmentId, statusCode, eventAt])
  @@index([shipmentId])
}

model CarrierScore {
  id          String          @id @default(cuid())
  carrierId   String
  carrier     Carrier         @relation(fields: [carrierId], references: [id])
  category    ProductCategory?
  region      String?
  onTimeRate  Float
  returnRate  Float
  sampleSize  Int
  score       Int
  computedAt  DateTime         @default(now())

  @@index([carrierId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  companyId  String?
  action     String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([companyId])
}

model RateLimitBucket {
  id      String   @id @default(cuid())
  bucket  String
  key     String
  count   Int      @default(1)
  resetAt DateTime

  @@unique([bucket, key])
  @@index([resetAt])
}

model CarrierConnectionRequest {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  providerKey String
  createdAt   DateTime @default(now())

  @@unique([companyId, providerKey])
  @@index([companyId])
}

model CarrierCredential {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  providerKey    String
  credentialsEnc String   // JSON.stringify(CarrierCredentials), encrypted via field-encryption.ts
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, providerKey])
  @@index([companyId])
}

/// One row per shipment, written once at submit: what was chosen, out of what,
/// and by which rules. A SNAPSHOT on purpose — chosenServiceName and
/// chosenPriceRub duplicate Shipment.selectedOfferServiceName / plannedCost
/// deliberately, so that a later edit to the Shipment cannot rewrite what the
/// seller was actually shown. Absent for shipments created before this model,
/// and absent when the write failed after the carrier order already existed:
/// the order matters more than the report, so a report must count rows without
/// a decision instead of assuming every shipment has one.
model ShipmentDecision {
  id         String   @id @default(cuid())
  shipmentId String   @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// Which revision of the decision rules produced this row. Bumped when the
  /// rules change, so old rows stay readable instead of being reinterpreted.
  rulesVersion Int
  decidedAt    DateTime

  /// Copied from Shipment.selectionMode, same nullability: NULL means the row
  /// predates the field or nothing was recorded, not «MANUAL».
  selectionMode SelectionMode?

  chosenAdapterKey      String
  chosenServiceName     String?
  /// KOPECKS, like Shipment.plannedCost — the two are compared, and a ruble
  /// column between them would round the difference away.
  chosenPriceKop        Int
  chosenPriceIsEstimate Boolean

  /// @db.Date on purpose: these are CALENDAR DAYS and are compared as such. A
  /// timestamp would carry a time zone and shift the day across a boundary.
  chosenDeadlineDay   DateTime?      @db.Date
  chosenDeadlineBasis DeadlineBasis?

  /// Cheapest offer that was no later than the chosen one and strictly cheaper.
  /// All four NULL together when no such offer existed.
  altAdapterKey  String?
  altPriceKop    Int?
  /// THE ESTIMATE FLAG MUST STAND ON BOTH SIDES, because two prices are being
  /// compared and only one of them may be a commitment. CDEK's price is marked
  /// an estimate on 100% of its offers, and the 28.08 production measurement
  /// showed it is systematically BELOW the invoice, because the mandatory
  /// declared-value fee cannot be quoted by any calculator method available to
  /// us (docs/research/cdek-insurance-parameter-2026-08-28.md). Comparing a
  /// firm price against an estimate without carrying the flag would manufacture
  /// an overpayment claim that the numbers do not support.
  /// NULLABLE because there may be no alternative at all, and false would be a
  /// statement about an offer that does not exist.
  altPriceIsEstimate Boolean?
  altDeadlineDay DateTime? @db.Date

  offersTotal   Int
  carriersTotal Int
  /// Whether every offer in the list carried an adapterKey. False means the
  /// comparison cannot be attributed per carrier and the row must be excluded
  /// from per-carrier reporting rather than counted as one carrier.
  attributionComplete Boolean

  @@index([decidedAt])
  @@index([chosenAdapterKey])
}
